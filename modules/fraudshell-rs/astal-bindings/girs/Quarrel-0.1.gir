	<enumeration name="ParseError" c:type="QuarrelParseError" glib:type-name="QuarrelParseError" glib:get-type="quarrel_parse_error_get_type" glib:error-domain="quarrel-parse-error-quark">
		<doc xml:whitespace="preserve">Possible errors on [method@Command.parse].</doc>
		<member name="unknown_command" c:identifier="QUARREL_PARSE_ERROR_UNKNOWN_COMMAND" value="0">
			<doc xml:whitespace="preserve">An unknown command was encountered.</doc>
		</member>
		<member name="missing_args" c:identifier="QUARREL_PARSE_ERROR_MISSING_ARGS" value="1">
			<doc xml:whitespace="preserve">Number of arguments is less than expected.</doc>
		</member>
		<member name="extra_args" c:identifier="QUARREL_PARSE_ERROR_EXTRA_ARGS" value="2">
			<doc xml:whitespace="preserve">Number of arguments is more than expected.</doc>
		</member>
		<member name="missing_option_value" c:identifier="QUARREL_PARSE_ERROR_MISSING_OPTION_VALUE" value="3">
			<doc xml:whitespace="preserve">Option value is missing.</doc>
		</member>
		<member name="invalid_option" c:identifier="QUARREL_PARSE_ERROR_INVALID_OPTION" value="4">
			<doc xml:whitespace="preserve">Failed to parse the option value.</doc>
		</member>
		<member name="unknown_option" c:identifier="QUARREL_PARSE_ERROR_UNKNOWN_OPTION" value="5">
			<doc xml:whitespace="preserve">An unknown option was encountered.</doc>
		</member>
	</enumeration>
