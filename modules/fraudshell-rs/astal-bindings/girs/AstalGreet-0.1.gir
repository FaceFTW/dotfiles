		<glib:signal name="visible-request">
			<doc xml:whitespace="preserve">Respond with [method@AstalGreet.Greeter.post_auth]. Emitted when input is required from the user. The response is not secret and can be
visible.</doc>
			<return-value transfer-ownership="full">
				<type name="none" c:type="void" />
			</return-value>
			<parameters>
				<parameter name="message" transfer-ownership="none">
					<type name="utf8" c:type="const gchar*" />
				</parameter>
			</parameters>
		</glib:signal>
		<glib:signal name="secret-request">
			<doc xml:whitespace="preserve">Respond with [method@AstalGreet.Greeter.post_auth]. Emitted when input is required from the user. The response is secret and should be
invisible.</doc>
			<return-value transfer-ownership="full">
				<type name="none" c:type="void" />
			</return-value>
			<parameters>
				<parameter name="message" transfer-ownership="none">
					<type name="utf8" c:type="const gchar*" />
				</parameter>
			</parameters>
		</glib:signal>
		<glib:signal name="info-message">
			<doc xml:whitespace="preserve">Information that should be shown to the user.</doc>
			<return-value transfer-ownership="full">
				<type name="none" c:type="void" />
			</return-value>
			<parameters>
				<parameter name="message" transfer-ownership="none">
					<type name="utf8" c:type="const gchar*" />
				</parameter>
			</parameters>
		</glib:signal>
		<glib:signal name="error-message">
			<doc xml:whitespace="preserve">Error message that should be shown to the user.</doc>
			<return-value transfer-ownership="full">
				<type name="none" c:type="void" />
			</return-value>
			<parameters>
				<parameter name="message" transfer-ownership="none">
					<type name="utf8" c:type="const gchar*" />
				</parameter>
			</parameters>
		</glib:signal>
		<glib:signal name="cancelled">
			<doc xml:whitespace="preserve">Emitted when the session is cancelled due to an error. The login can be restarted with [method@AstalGreet.Greeter.create_session].</doc>
			<return-value transfer-ownership="full">
				<type name="none" c:type="void" />
			</return-value>
			<parameters>
				<parameter name="_error_" transfer-ownership="none">
					<type name="AstalGreet.Error" c:type="AstalGreetError*" />
				</parameter>
			</parameters>
		</glib:signal>
		<glib:signal name="authenticated">
			<doc xml:whitespace="preserve">Emitted on successful authentication to indicate that the session can be started using [method@AstalGreet.Greeter.start_session].</doc>
			<return-value transfer-ownership="full">
				<type name="none" c:type="void" />
			</return-value>
		</glib:signal>
	</class>
